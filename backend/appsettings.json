{
  // =====================================================================
  //  PERSONAL / SECRET SETTINGS
  //  Put your own values in the places marked "YOUR_...".
  //  Do NOT push real passwords or API keys to a public GitHub repository.
  // =====================================================================

  "ConnectionStrings": {
    // PERSONAL DATA: your PostgreSQL password.
    // Replace YOUR_POSTGRES_PASSWORD with the password you chose when you installed PostgreSQL.
    // The database "smartlearn_db" is created automatically on the first run.
    "DefaultConnection": "Host=localhost;Port=5432;Database=smartlearn_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },

  "Jwt": {
    // SECRET: used to sign login tokens. Change it to your own long random text
    // (at least 32 characters). Anyone who knows it can create fake logins.
    "Key": "CHANGE-ME-this-is-a-development-only-secret-key-1234567890",
    "Issuer": "SmartLearn.Api",
    "Audience": "SmartLearn.Frontend",
    "ExpiryHours": 24
  },

  "Cloudinary": {
    // PERSONAL DATA: your Cloudinary account keys (free plan is enough).
    // 1. Sign up at https://cloudinary.com/users/register_free
    // 2. Open the Dashboard (Settings -> API Keys) and copy the three values below.
    // While these still start with "YOUR_", uploads are saved in the backend's
    // wwwroot/uploads folder instead, so the project works without an account.
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },

  "Email": {
    // PERSONAL DATA: emails (sign-up codes, password reset, enrollment) are sent with Brevo.
    // 1. Create a free account at https://www.brevo.com (300 emails per day for free).
    // 2. Senders, Domains & Dedicated IPs -> Senders -> add and verify YOUR email address.
    // 3. SMTP & API -> API Keys -> Generate a new API key, and paste it below.
    // While these still start with "YOUR_", no email is sent: the codes are written
    // to the backend log (console) instead, so you can test on your computer.
    "BrevoApiKey": "YOUR_BREVO_API_KEY",
    "SenderEmail": "YOUR_VERIFIED_SENDER_EMAIL",
    "SenderName": "SmartLearn"
  },

  // SECRET ON A LIVE SERVER: password of the 3 demo accounts
  // (admin@smartlearn.dev, instructor@smartlearn.dev, student@smartlearn.dev).
  // It is only used the first time, when the database is empty.
  // On Render, set the "DemoPassword" environment variable to your own strong password.
  "DemoPassword": "Password@123",

  // Address of the React app, allowed by CORS.
  // On Render, set the "FrontendUrl" environment variable to your Vercel address.
  "FrontendUrl": "http://localhost:5173",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
