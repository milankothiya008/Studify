@model LoginViewModel
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Sign in</h1>

        <form asp-action="Login" method="post" class="card card-body shadow-sm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username"
                       autofocus placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>

        @* Seeded accounts exist only where the sample data switch is on. *@
        @if (Environment.IsDevelopment() && Configuration.GetValue("Database:SeedSampleData", false))
        {
            <div class="card card-body mt-3 bg-body-tertiary small">
                <div class="fw-semibold mb-1">Seeded accounts</div>
                <div class="text-secondary">
                    <code>admin@smartlearning.dev</code> &middot;
                    <code>grace@smartlearning.dev</code><br />
                    Password <code>@SmartLearningPlatform.Data.DbInitializer.SeedPassword</code>.
                    The third seeded account is <em>Pending verification</em> and cannot sign in.
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
