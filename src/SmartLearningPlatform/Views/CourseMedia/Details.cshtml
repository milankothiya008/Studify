@model CourseMedia
@{
    ViewData["Title"] = $"Media — {Model.Course?.Title ?? Model.CourseId.ToString()}";
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@(Model.Course?.Title ?? $"Course #{Model.CourseId}")</h1>
        <a class="text-secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">
            Back to the course
        </a>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">All media</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CourseId">Edit</a>
    </div>
</div>

@if (Model.HasThumbnail)
{
    <img src="@Model.ThumbnailUrl" class="img-fluid rounded shadow-sm mb-3"
         alt="@Model.Course?.Title" style="max-height: 300px;" />
}

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Thumbnail URL</dt>
            <dd class="col-sm-8 text-break">
                @if (Model.ThumbnailUrl is not null)
                {
                    <a href="@Model.ThumbnailUrl" target="_blank" rel="noopener noreferrer">@Model.ThumbnailUrl</a>
                }
                else { <span class="text-secondary">—</span> }
            </dd>

            <dt class="col-sm-4">Promotional video URL</dt>
            <dd class="col-sm-8 text-break">
                @if (Model.PromotionalLessonUrl is not null)
                {
                    <a href="@Model.PromotionalLessonUrl" target="_blank" rel="noopener noreferrer">@Model.PromotionalLessonUrl</a>
                }
                else { <span class="text-secondary">—</span> }
            </dd>

            <dt class="col-sm-4">Certificate template URL</dt>
            <dd class="col-sm-8 text-break">
                @if (Model.CertificateTemplateUrl is not null)
                {
                    <a href="@Model.CertificateTemplateUrl" target="_blank" rel="noopener noreferrer">@Model.CertificateTemplateUrl</a>
                }
                else { <span class="text-secondary">—</span> }
            </dd>
        </dl>
    </div>
</div>
