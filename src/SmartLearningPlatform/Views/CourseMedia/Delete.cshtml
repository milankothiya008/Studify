@model CourseMedia
@{
    ViewData["Title"] = "Delete course media";
}

<h1 class="h3 mb-3">Delete this media row?</h1>

<div class="alert alert-danger">
    <code>course_media</code> has no <code>deleted_at</code> column, so this is a real
    delete. The course survives but drops back to incomplete and cannot leave Draft.
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Course</dt>
            <dd class="col-sm-9">@(Model.Course?.Title ?? $"#{Model.CourseId}")</dd>

            <dt class="col-sm-3">Thumbnail</dt>
            <dd class="col-sm-9 text-break small">@(Model.ThumbnailUrl ?? "—")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.CourseId" method="post" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete media</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.CourseId">Cancel</a>
</form>
