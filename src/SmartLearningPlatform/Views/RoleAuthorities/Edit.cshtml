@model RoleAuthority
@{
    ViewData["Title"] = "Edit authority grant";
}

<h1 class="h3 mb-3">Edit authority grant</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" view-data="ViewData" />

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
