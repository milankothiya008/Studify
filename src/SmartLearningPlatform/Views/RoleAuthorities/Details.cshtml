@model RoleAuthority
@{
    ViewData["Title"] = "Authority grant";
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <h1 class="h3 mb-0">Authority grant</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">
                @if (Model.Role is not null)
                {
                    <a asp-controller="Roles" asp-action="Details" asp-route-id="@Model.RoleId">
                        <code>@Model.Role.Name</code>
                    </a>
                }
                else
                {
                    <span class="text-secondary">#@Model.RoleId</span>
                }
            </dd>

            <dt class="col-sm-3">Authority</dt>
            <dd class="col-sm-9">
                @if (Model.Authority is not null)
                {
                    <a asp-controller="Authorities" asp-action="Details" asp-route-id="@Model.AuthorityId">
                        <code>@Model.Authority.Name</code>
                    </a>
                    @if (Model.Authority.Description is not null)
                    {
                        <div class="small text-secondary">@Model.Authority.Description</div>
                    }
                }
                else
                {
                    <span class="text-secondary">#@Model.AuthorityId</span>
                }
            </dd>

            <dt class="col-sm-3">Granted at</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
