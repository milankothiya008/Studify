@model CoursePricing
@{
    ViewData["Title"] = $"Pricing — {Model.Course?.Title ?? Model.CourseId.ToString()}";
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@(Model.Course?.Title ?? $"Course #{Model.CourseId}")</h1>
        <a class="text-secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">
            Back to the course
        </a>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">All pricing</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CourseId">Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center d-flex flex-column justify-content-center">
                @if (Model.IsFree)
                {
                    <div class="display-4 text-success fw-semibold">Free</div>
                }
                else
                {
                    <div class="display-4 fw-semibold">@Model.Currency.Format(Model.EffectivePrice)</div>
                    @if (Model.DiscountPercentage is int percent)
                    {
                        <div class="mt-2">
                            <span class="text-decoration-line-through text-secondary">
                                @Model.Currency.Format(Model.Price)
                            </span>
                            <span class="badge text-bg-danger ms-1">@percent% off</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Record</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">List price</dt>
                    <dd class="col-sm-7">@Model.Currency.Format(Model.Price)</dd>

                    <dt class="col-sm-5">Discount price</dt>
                    <dd class="col-sm-7">@Model.Currency.Format(Model.DiscountPrice)</dd>

                    <dt class="col-sm-5">Effective price</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.Currency.Format(Model.EffectivePrice)</dd>

                    <dt class="col-sm-5">Currency</dt>
                    <dd class="col-sm-7">@Model.Currency</dd>

                    <dt class="col-sm-5">Created</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-5">Updated</dt>
                    <dd class="col-sm-7">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
