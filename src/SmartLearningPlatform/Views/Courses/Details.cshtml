@model Course
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge text-bg-@Model.CourseStatus.BadgeClass()">@Model.CourseStatus</span>
            <span class="badge text-bg-light border">@Model.CourseLevel</span>
        </div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-secondary mb-0">@Model.Subtitle</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

@if (!Model.IsReadyForReview)
{
    <div class="alert alert-info">
        This course is missing
        @{
            var missing = new List<string>();
            if (Model.Detail is null) { missing.Add("details"); }
            if (Model.Media is null) { missing.Add("media"); }
            if (Model.Pricing is null) { missing.Add("pricing"); }
        }
        <strong>@string.Join(", ", missing)</strong>. It cannot leave Draft until all three exist.
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Details</span>
                @if (Model.Detail is null)
                {
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="CourseDetails" asp-action="Create" asp-route-courseId="@Model.Id">Add</a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="CourseDetails" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                }
            </div>
            <div class="card-body">
                @if (Model.Detail is null)
                {
                    <p class="text-secondary small mb-0">No details row yet.</p>
                }
                else
                {
                    <h3 class="h6 text-uppercase text-secondary">Description</h3>
                    <p style="white-space: pre-line;">@Model.Detail.Description</p>

                    <h3 class="h6 text-uppercase text-secondary">Requirements</h3>
                    <p style="white-space: pre-line;">@Model.Detail.Requirement</p>

                    <h3 class="h6 text-uppercase text-secondary">Learning outcomes</h3>
                    <p style="white-space: pre-line;">@Model.Detail.LearningOutcome</p>

                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var feature in new[]
                        {
                            ("Certificate", Model.Detail.HasCertificate),
                            ("Assignments", Model.Detail.HasAssignment),
                            ("Project", Model.Detail.HasProject),
                            ("Quiz", Model.Detail.HasQuiz),
                        })
                        {
                            <span class="badge @(feature.Item2 ? "text-bg-success" : "text-bg-light border text-secondary")">
                                @feature.Item1
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Media</span>
                @if (Model.Media is null)
                {
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="CourseMedia" asp-action="Create" asp-route-courseId="@Model.Id">Add</a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="CourseMedia" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                }
            </div>
            <div class="card-body">
                @if (Model.Media is null)
                {
                    <p class="text-secondary small mb-0">No media row yet.</p>
                }
                else
                {
                    @if (Model.Media.HasThumbnail)
                    {
                        <img src="@Model.Media.ThumbnailUrl" class="img-fluid rounded mb-3"
                             alt="@Model.Title" style="max-height: 240px;" />
                    }
                    <dl class="row mb-0 small">
                        <dt class="col-sm-4">Thumbnail</dt>
                        <dd class="col-sm-8 text-break">@(Model.Media.ThumbnailUrl ?? "—")</dd>

                        <dt class="col-sm-4">Promotional video</dt>
                        <dd class="col-sm-8 text-break">@(Model.Media.PromotionalLessonUrl ?? "—")</dd>

                        <dt class="col-sm-4">Certificate template</dt>
                        <dd class="col-sm-8 text-break">@(Model.Media.CertificateTemplateUrl ?? "—")</dd>
                    </dl>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Pricing</span>
                @if (Model.Pricing is null)
                {
                    <a class="btn btn-sm btn-outline-primary"
                       asp-controller="CoursePricing" asp-action="Create" asp-route-courseId="@Model.Id">Add</a>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="CoursePricing" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                }
            </div>
            <div class="card-body">
                @if (Model.Pricing is null)
                {
                    <p class="text-secondary small mb-0">No pricing row yet.</p>
                }
                else if (Model.Pricing.IsFree)
                {
                    <div class="display-6 text-success fw-semibold">Free</div>
                }
                else
                {
                    <div class="display-6 fw-semibold">
                        @Model.Pricing.Currency.Format(Model.Pricing.EffectivePrice)
                    </div>
                    @if (Model.Pricing.DiscountPercentage is int percent)
                    {
                        <div class="small">
                            <span class="text-decoration-line-through text-secondary">
                                @Model.Pricing.Currency.Format(Model.Pricing.Price)
                            </span>
                            <span class="badge text-bg-danger ms-1">@percent% off</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">Instructor</div>
            <div class="card-body">
                @if (Model.Instructor is null)
                {
                    <p class="text-secondary small mb-0">#@Model.InstructorId</p>
                }
                else
                {
                    <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.InstructorId">
                        @Model.Instructor.DisplayName
                    </a>
                    <div class="small text-secondary">@Model.Instructor.Email</div>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">Move to status</div>
            <div class="card-body">
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <select name="status" class="form-select form-select-sm"
                            asp-items="Html.GetEnumSelectList<CourseStatus>()"></select>
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Apply</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Record</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-6">Created</dt>
                    <dd class="col-6">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-6">Updated</dt>
                    <dd class="col-6">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
