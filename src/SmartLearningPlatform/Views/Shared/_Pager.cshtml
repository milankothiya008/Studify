@*
    Pager for any PagedResult<T>. The current query string is carried forward so
    filters survive a page change; only the "page" key is replaced.
*@
@model SmartLearningPlatform.Repositories.IPagedResultInfo
@{
    if (Model is null || Model.TotalPages <= 1) { return; }

    var routeValues = new Dictionary<string, string?>();
    foreach (var pair in Context.Request.Query)
    {
        if (!string.Equals(pair.Key, "page", StringComparison.OrdinalIgnoreCase))
        {
            routeValues[pair.Key] = pair.Value.ToString();
        }
    }

    // Window of page links around the current page.
    var first = Math.Max(1, Model.PageNumber - 2);
    var last = Math.Min(Model.TotalPages, first + 4);
    first = Math.Max(1, last - 4);
}

<nav aria-label="Pagination" class="d-flex flex-wrap align-items-center justify-content-between gap-2">
    <span class="small text-secondary">
        Showing @Model.FirstItemOnPage&ndash;@Model.LastItemOnPage of @Model.TotalCount
    </span>

    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link"
               asp-all-route-data="routeValues"
               asp-route-page="@(Model.PageNumber - 1)">Previous</a>
        </li>

        @for (var p = first; p <= last; p++)
        {
            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                <a class="page-link" asp-all-route-data="routeValues" asp-route-page="@p">@p</a>
            </li>
        }

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link"
               asp-all-route-data="routeValues"
               asp-route-page="@(Model.PageNumber + 1)">Next</a>
        </li>
    </ul>
</nav>
