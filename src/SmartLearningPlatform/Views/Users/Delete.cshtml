@model User
@{
    ViewData["Title"] = $"Retire {Model.Email}";
}

<h1 class="h3 mb-3">Retire this user?</h1>

<div class="alert alert-warning">
    The account is <strong>soft-deleted</strong>: its <code>deleted_at</code> column is
    stamped, so it disappears from every list while audit history and any course it
    authored keep resolving. Nothing is erased.
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@(Model.Profile?.FullName ?? "—")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge text-bg-@Model.Status.BadgeClass()">@Model.Status</span></dd>

            <dt class="col-sm-3">Roles</dt>
            <dd class="col-sm-9">
                @if (Model.UserRoles.Any())
                {
                    @string.Join(", ", Model.UserRoles.Where(ur => ur.Role is not null).Select(ur => ur.Role!.Name))
                }
                else
                {
                    <span class="text-secondary">None</span>
                }
            </dd>

            <dt class="col-sm-3">Courses taught</dt>
            <dd class="col-sm-9">@Model.CoursesTaught.Count</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Retire user</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
