@model CourseDetail
@{
    ViewData["Title"] = "Delete course details";
}

<h1 class="h3 mb-3">Delete this details row?</h1>

<div class="alert alert-danger">
    <code>course_details</code> has no <code>deleted_at</code> column, so this is a real
    delete. The course survives but drops back to incomplete and cannot leave Draft.
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Course</dt>
            <dd class="col-sm-9">@(Model.Course?.Title ?? $"#{Model.CourseId}")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9 small">@Model.Description</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.CourseId" method="post" class="d-flex gap-2">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete details</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.CourseId">Cancel</a>
</form>
