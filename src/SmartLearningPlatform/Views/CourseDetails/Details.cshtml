@model CourseDetail
@{
    ViewData["Title"] = Model.Course?.Title ?? "Course details";
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@(Model.Course?.Title ?? $"Course #{Model.CourseId}")</h1>
        <a class="text-secondary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">
            Back to the course
        </a>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">All details</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CourseId">Edit</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h6 text-uppercase text-secondary">Description</h2>
        <p style="white-space: pre-line;">@Model.Description</p>

        <h2 class="h6 text-uppercase text-secondary">Requirements</h2>
        <p style="white-space: pre-line;">@Model.Requirement</p>

        <h2 class="h6 text-uppercase text-secondary">Learning outcomes</h2>
        <p class="mb-0" style="white-space: pre-line;">@Model.LearningOutcome</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Features</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-6">Certificate on completion</dt>
            <dd class="col-sm-6">@(Model.HasCertificate ? "Yes" : "No")</dd>

            <dt class="col-sm-6">Has assignments</dt>
            <dd class="col-sm-6">@(Model.HasAssignment ? "Yes" : "No")</dd>

            <dt class="col-sm-6">Has project</dt>
            <dd class="col-sm-6">@(Model.HasProject ? "Yes" : "No")</dd>

            <dt class="col-sm-6">Has quiz</dt>
            <dd class="col-sm-6">@(Model.HasQuiz ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>
