@model UserProfile
@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@Model.FullName</h1>
        @if (Model.User is not null)
        {
            <a class="text-secondary" asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId">
                @Model.User.Email
            </a>
        }
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.UserId">Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="@Model.FullName"
                         class="img-fluid rounded mb-3" style="max-height: 220px;" />
                }
                else
                {
                    <div class="bg-body-secondary rounded d-flex align-items-center justify-content-center mb-3"
                         style="height: 160px;">
                        <span class="display-5 text-secondary">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</span>
                    </div>
                }
                <div class="fw-semibold">@Model.FullName</div>
                @if (Model.Age is int age)
                {
                    <div class="small text-secondary">@age years old</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">Profile</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Profession</dt>
                    <dd class="col-sm-8">@(Model.Profession?.ToString() ?? "—")</dd>

                    <dt class="col-sm-4">Education level</dt>
                    <dd class="col-sm-8">@(Model.EducationLevel?.ToString() ?? "—")</dd>

                    <dt class="col-sm-4">Gender</dt>
                    <dd class="col-sm-8">@(Model.Gender?.ToString() ?? "—")</dd>

                    <dt class="col-sm-4">Date of birth</dt>
                    <dd class="col-sm-8">@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "—")</dd>

                    <dt class="col-sm-4">Institute</dt>
                    <dd class="col-sm-8">@(Model.InstituteName ?? "—")</dd>

                    <dt class="col-sm-4">About</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.AboutMe) ? "—" : Model.AboutMe)</dd>
                </dl>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var address in new[] { ("Home address", Model.HomeAddress), ("Work address", Model.WorkAddress) })
            {
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white fw-semibold">@address.Item1</div>
                        <div class="card-body">
                            @if (address.Item2.IsEmpty)
                            {
                                <p class="text-secondary small mb-0">Not set.</p>
                            }
                            else
                            {
                                <address class="mb-0 small">
                                    @if (!string.IsNullOrWhiteSpace(address.Item2.Street)) { @address.Item2.Street <br /> }
                                    @if (!string.IsNullOrWhiteSpace(address.Item2.City)) { @address.Item2.City <br /> }
                                    @if (!string.IsNullOrWhiteSpace(address.Item2.State)) { @address.Item2.State <br /> }
                                    @if (!string.IsNullOrWhiteSpace(address.Item2.PostalCode)) { @address.Item2.PostalCode <br /> }
                                    @if (!string.IsNullOrWhiteSpace(address.Item2.Country)) { @address.Item2.Country }
                                </address>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
