@model UserSocialLink
@{
    ViewData["Title"] = $"{Model.Platform} link";
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <h1 class="h3 mb-0">@Model.Platform link</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">User</dt>
            <dd class="col-sm-9">
                @if (Model.User is not null)
                {
                    <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.UserId">
                        @Model.User.DisplayName
                    </a>
                }
                else
                {
                    <span class="text-secondary">#@Model.UserId</span>
                }
            </dd>

            <dt class="col-sm-3">Platform</dt>
            <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.Platform</span></dd>

            <dt class="col-sm-3">URL</dt>
            <dd class="col-sm-9">
                <a href="@Model.Url" target="_blank" rel="noopener noreferrer">@Model.Url</a>
            </dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Updated</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
