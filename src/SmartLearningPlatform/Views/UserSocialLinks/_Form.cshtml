@model UserSocialLink
@{
    var userList = ViewData["UserList"] as SelectList;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="UserId" class="form-label"></label>
        <select asp-for="UserId" class="form-select" asp-items="userList">
            <option value="">Select a user…</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Platform" class="form-label"></label>
        <select asp-for="Platform" class="form-select" asp-items="Html.GetEnumSelectList<SocialPlatform>()"></select>
        <span asp-validation-for="Platform" class="text-danger small"></span>
        <div class="form-text">One link per platform per user.</div>
    </div>

    <div class="col-12">
        <label asp-for="Url" class="form-label"></label>
        <input asp-for="Url" class="form-control" placeholder="https://…" />
        <span asp-validation-for="Url" class="text-danger small"></span>
    </div>
</div>
