@model IReadOnlyList<UserSocialLink>
@{
    ViewData["Title"] = "Social links";
    var userList = ViewData["UserList"] as SelectList;
    var filterUserId = ViewData["FilterUserId"] as long?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Social links</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-userId="@filterUserId">New link</a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="userId">User</label>
            <select id="userId" name="userId" class="form-select" asp-items="userList">
                <option value="">All users</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No social links yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Platform</th>
                        <th>URL</th>
                        <th>Added</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var link in Model)
                {
                    <tr>
                        <td>
                            @if (link.User is not null)
                            {
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@link.UserId">
                                    @link.User.DisplayName
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary">#@link.UserId</span>
                            }
                        </td>
                        <td><span class="badge text-bg-secondary">@link.Platform</span></td>
                        <td class="text-truncate" style="max-width: 320px;">
                            <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Url</a>
                        </td>
                        <td class="small text-secondary">@link.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@link.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@link.Id">Remove</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
