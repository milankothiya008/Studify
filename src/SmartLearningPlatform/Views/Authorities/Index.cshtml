@model IReadOnlyList<IGrouping<string, Authority>>
@{
    ViewData["Title"] = "Authorities";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Authorities</h1>
        <p class="text-secondary mb-0 small">
            Fine-grained permissions, named <code>resource:action</code> and grouped by resource.
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New authority</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No authorities yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (var group in Model)
        {
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-semibold text-capitalize">
                        @group.Key
                        <span class="badge text-bg-light border ms-1">@group.Count()</span>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var authority in group)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div class="min-width-0">
                                    <a asp-action="Details" asp-route-id="@authority.Id">
                                        <code>@authority.Name</code>
                                    </a>
                                    @if (authority.Description is not null)
                                    {
                                        <div class="small text-secondary">@authority.Description</div>
                                    }
                                </div>
                                <div class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@authority.Id">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@authority.Id">Retire</a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}
