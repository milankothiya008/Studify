@model Role
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1"><code>@Model.Name</code></h1>
        <p class="text-secondary mb-0">@(Model.Description ?? "No description.")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Record</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Name</dt>
                    <dd class="col-sm-7"><code>@Model.Name</code></dd>

                    <dt class="col-sm-5">Created</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-5">Updated</dt>
                    <dd class="col-sm-7">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Authorities granted</span>
                <a class="btn btn-sm btn-outline-primary"
                   asp-controller="RoleAuthorities" asp-action="Create" asp-route-roleId="@Model.Id">Grant</a>
            </div>
            @if (!Model.RoleAuthorities.Any())
            {
                <div class="card-body text-secondary small">
                    This role grants nothing yet.
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var grant in Model.RoleAuthorities.Where(g => g.Authority is not null)
                                                .OrderBy(g => g.Authority!.Name))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div>
                                <code>@grant.Authority!.Name</code>
                                @if (grant.Authority.Description is not null)
                                {
                                    <div class="small text-secondary">@grant.Authority.Description</div>
                                }
                            </div>
                            <a class="btn btn-sm btn-outline-danger"
                               asp-controller="RoleAuthorities" asp-action="Delete" asp-route-id="@grant.Id">Revoke</a>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
