@model IReadOnlyList<Role>
@{
    ViewData["Title"] = "Roles";
    var usage = ViewData["UsageCounts"] as IReadOnlyDictionary<long, (int Users, int Authorities)>
                ?? new Dictionary<long, (int, int)>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Roles</h1>
        <p class="text-secondary mb-0 small">
            A role bundles authorities; users get authorities by holding a role.
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New role</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No roles yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-center">Users</th>
                        <th class="text-center">Authorities</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model)
                {
                    var counts = usage.TryGetValue(role.Id, out var c) ? c : (Users: 0, Authorities: 0);
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@role.Id"><code>@role.Name</code></a></td>
                        <td class="small text-secondary">@(role.Description ?? "—")</td>
                        <td class="text-center">
                            <a class="badge text-bg-light border text-decoration-none"
                               asp-controller="UserRoles" asp-action="Index" asp-route-roleId="@role.Id">
                                @counts.Users
                            </a>
                        </td>
                        <td class="text-center">
                            <a class="badge text-bg-light border text-decoration-none"
                               asp-controller="RoleAuthorities" asp-action="Index" asp-route-roleId="@role.Id">
                                @counts.Authorities
                            </a>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@role.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@role.Id">Retire</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
