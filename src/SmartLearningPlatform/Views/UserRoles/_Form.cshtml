@model UserRole
@{
    var userList = ViewData["UserList"] as SelectList;
    var roleList = ViewData["RoleList"] as SelectList;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="UserId" class="form-label"></label>
        <select asp-for="UserId" class="form-select" asp-items="userList">
            <option value="">Select a user…</option>
        </select>
        <span asp-validation-for="UserId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="RoleId" class="form-label"></label>
        <select asp-for="RoleId" class="form-select" asp-items="roleList">
            <option value="">Select a role…</option>
        </select>
        <span asp-validation-for="RoleId" class="text-danger small"></span>
        <div class="form-text">A user can hold each role only once.</div>
    </div>
</div>
