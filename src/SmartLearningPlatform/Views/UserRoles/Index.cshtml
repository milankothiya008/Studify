@model IReadOnlyList<UserRole>
@{
    ViewData["Title"] = "User roles";
    var userList = ViewData["UserList"] as SelectList;
    var roleList = ViewData["RoleList"] as SelectList;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">User &rarr; role</h1>
        <p class="text-secondary mb-0 small">
            Rows in <code>user_roles</code>. One row per user and role.
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Assign role</a>
</div>

<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="userId">User</label>
            <select id="userId" name="userId" class="form-select" asp-items="userList">
                <option value="">All users</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="roleId">Role</label>
            <select id="roleId" name="roleId" class="form-select" asp-items="roleList">
                <option value="">All roles</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-light border">No role assignments match this filter.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Assigned</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var assignment in Model)
                {
                    <tr>
                        <td>
                            @if (assignment.User is not null)
                            {
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@assignment.UserId">
                                    @assignment.User.DisplayName
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary">#@assignment.UserId</span>
                            }
                        </td>
                        <td>
                            @if (assignment.Role is not null)
                            {
                                <a asp-controller="Roles" asp-action="Details" asp-route-id="@assignment.RoleId">
                                    <code>@assignment.Role.Name</code>
                                </a>
                            }
                            else
                            {
                                <span class="text-secondary">#@assignment.RoleId</span>
                            }
                        </td>
                        <td class="small text-secondary">@assignment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@assignment.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@assignment.Id">Unassign</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
